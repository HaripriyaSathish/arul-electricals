# Copy this file to backend/.env for LOCAL development (MySQL / XAMPP).
# On Render, set these as Environment Variables instead (DATABASE_URL for Neon).

# --- Local MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=arul_electricals
DB_USER=root
DB_PASS=your-mysql-password

# --- OR PostgreSQL (Neon). When set, it is used instead of MySQL ---
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Allowed frontend URLs for local development (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MAX_UPLOAD_MB=8
TOKEN_TTL_HOURS=12

# Secret for encrypting the SMTP password. Generate: php -r "echo bin2hex(random_bytes(32));"
# Use the SAME value locally and on Render so saved SMTP passwords keep working.
APP_KEY=change-me

# Where images are stored: disk (default for MySQL) or db (default for PostgreSQL / Render)
# MEDIA_STORAGE=disk
